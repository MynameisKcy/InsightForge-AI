# =============================================================
# InsightForge AI — 环境变量模板
# 用法：cp .env.example .env && 填入你的 API Key
# 申请地址: https://dashscope.console.aliyun.com/apiKey
# 请勿提交 .env 到 git（已在 .gitignore 中忽略）
# =============================================================

# DashScope (通义千问) API Key —— 必填
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 模型配置（可选，默认取 agent/config/rag.yml）──
# 大语言模型（对话/分析）—— 通义千问
# CHAT_MODEL_NAME=qwen-plus
# 向量嵌入模型（RAG 检索）—— DashScope Embeddings
# EMBEDDING_MODEL_NAME=text-embedding-v4

# ── 用户配置加密密钥（可选）──
# UserSettingsDB Fernet 密钥；缺失时首次运行自动生成并写入 .env
# INSIGHTFORGE_SETTINGS_KEY=

# ── 可观测性（可选）──
# 设置 OTLP endpoint 即启用 OpenTelemetry 链路上报（不设则 NoOp 零开销）
# 本地配合 docker-compose 起 Jaeger 时取消注释：
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=insightforge
