# ============================================================
# InsightForge AI — 环境变量模板
# ============================================================
# 用法：cp .env.example .env && 填入你的 API Key
# 申请地址: https://dashscope.console.aliyun.com/apiKey
#
# ⚠️ 安全须知：
#   - 真实密钥请填入 .env（本文件的同级副本，已被 .gitignore 忽略）
#   - 切勿将真实 .env 提交到 git；切勿将密钥写入本 .env.example
#   - 若密钥已泄露，请立即在 DashScope 控制台吊销并重新生成
# ============================================================

# DashScope API Key —— 必填（在此填入你的真实 Key，仅本地 .env，勿提交）
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# ------------------------------------------------------------
# 模型配置（与 config/rag.yml 对应，环境变量优先于 yml 兜底）
# ------------------------------------------------------------
# 大语言模型（对话/分析）—— 通义千问
# qwen3.x 系列走 DashScope OpenAI 兼容端点（SDK 原生接口不识别新模型名，
# 会报 400 InvalidParameter url error），须同时配置 LLM_BASE_URL
CHAT_MODEL_NAME=qwen3.7-max-2026-06-08
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 向量嵌入模型（RAG 检索）—— DashScope Embeddings
EMBEDDING_MODEL_NAME=qwen3.7-text-embedding

# ── 用户配置加密密钥（可选）──
# UserSettingsDB Fernet 密钥；缺失时首次运行自动生成并写入 .env
# INSIGHTFORGE_SETTINGS_KEY=

# ------------------------------------------------------------
# 可观测性（可选）—— 设置 endpoint 即启用 OTel 链路上报（不设则 NoOp 零开销）
# 本地配合 Jaeger：仓库根执行 docker-compose up -d jaeger 后取消注释
# ------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=insightforge
