# 环境变量 / 密钥（含 DASHSCOPE_API_KEY）
.env

# ChromaDB 向量库持久化目录
chroma_db/

# 运行时生成的报告与图表
reports/

# md5 去重存储（运行时生成）
md5.text

# 日志
logs/

# SQLite 数据库（用户认证 / 图表知识库 / 对话历史）
*.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# IDE
.idea/
.vscode/

# Claude Code 本地状态
.claude/
.superpowers/

# 默认数据集 (2.1M, 停止版本跟踪, 磁盘保留; 全新 clone 需手动放回)
data/train.csv

# 用户上传的知识库文件（运行时上传到 data/，不入版本库）
data/*.pdf
data/*.docx
# 运行时用户数据：任务记录与按用户隔离的知识库目录（覆盖不到顶层的 *.pdf 规则）
data/tasks/
data/u_*/

# 本地辅助脚本与实验性文档（不纳入版本库）
docs/superpowers/
docs/specs/
docs/plans/
# scripts/ 下本地实验脚本不入库，但部署/基准脚本需要随仓库分发
scripts/*
!scripts/deploy.sh
!scripts/benchmark.py
claude.md

# 本机运行产物 / 工具本地状态（不入版本库）
tmp-kaleido/
.tmp/
.zcode/
*.db.bak

# OpenSpec spec-driven 规划产物与 IDE 集成（本地保留，不入库）
openspec/
.codebuddy/

# WorkBuddy agent 本地状态 / 记忆
.workbuddy/

# 测试运行残留的临时 CSV（data/tmp*.csv）
data/tmp*.csv
